# Amelia REST credentials — template.
#
#   cp scripts/amelia.env.example .env.amelia
#   then fill in the real values
#
# `.env.amelia` sits at the backend package root and is already excluded by
# `.env.*` in both the repo-root and backend .gitignore. Never move these
# values into .mcp.json, tenant JSON, or anything else git tracks.
#
# Verify before you save real secrets:
#   git check-ignore -v .env.amelia     # must print a matching rule

# REST context root. NOT /Amelia — that is the admin UI and 302s.
AMELIA_BASE_URL=https://eyefinity2.amelia.com/AmeliaRest

# --- Auth: pick ONE block ---

# Username / password  ->  X-Amelia-Rest-Token
# Quote the password: Amelia passwords commonly contain # @ $ ! which the shell
# and a bare .env parser would otherwise mangle.
AMELIA_USERNAME=
AMELIA_PASSWORD=""

# OAuth client credentials  ->  Authorization: Bearer
# AMELIA_CLIENT_ID=
# AMELIA_CLIENT_SECRET=""

# --- Domain ---
# Leave AMELIA_DOMAIN_ID blank and run `node scripts/amelia-export.mjs domains`
# to look up the UUID for this environment, then paste it here.
AMELIA_DOMAIN_ID=
# Optional: the domain *code*, used to resolve the UUID automatically.
AMELIA_DOMAIN=
